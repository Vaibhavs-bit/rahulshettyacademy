<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Default suite: sequential execution (parallel="none").
    To enable parallel execution, change parallel to "methods" or "classes" and set
    thread-count; DriverFactory already isolates each thread's WebDriver via ThreadLocal,
    so no further changes are required to run safely in parallel.
-->
<suite name="AutomationSuite" parallel="none" thread-count="1" verbose="1">

    <listeners>
        <listener class-name="com.automation.listeners.TestListener"/>
    </listeners>

    <test name="LoginTests">
        <classes>
            <class name="com.automation.tests.LoginTest"/>
        </classes>
    </test>

</suite>
