<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    parallel="methods" + thread-count="2": test methods run concurrently across 2 threads.
    DriverFactory isolates each thread's WebDriver via ThreadLocal, so this is safe as-is.

    Two <test> blocks demonstrate both grouping styles:
      - LoginRegressionTests: include smoke+regression, exclude negative
        (exclude always wins, so verifyLoginFailsWithInvalidCredentials - tagged negative - is skipped here)
      - LoginNegativeTests: include only negative
    @Test priority on each method (see LoginTest.java) controls ordering within a group.
-->
<suite name="AutomationSuite" parallel="methods" thread-count="2" verbose="1">

    <listeners>
        <listener class-name="com.automation.listeners.TestListener"/>
    </listeners>

    <test name="LoginRegressionTests">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="regression"/>
                <exclude name="negative"/>
            </run>
        </groups>
        <classes>
            <class name="com.automation.tests.LoginTest"/>
        </classes>
    </test>

    <test name="LoginNegativeTests">
        <groups>
            <run>
                <include name="negative"/>
            </run>
        </groups>
        <classes>
            <class name="com.automation.tests.LoginTest"/>
        </classes>
    </test>

</suite>
